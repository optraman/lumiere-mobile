# Скопируйте этот файл в .env и впишите свой бесплатный ключ TMDB
# (Настройки → API на https://www.themoviedb.org/, раздел "Ключ API (v3 auth)").
# Свой ключ, не бери чужой напрямую из кода ТВ-приложения без разрешения брата.
EXPO_PUBLIC_TMDB_API_KEY=

# Субтитры для любого фильма и серии (необязательно): бесплатный ключ Wyzie Subs —
# https://store.wyzie.io/redeem . Впишите его сюда сами; в чат не присылайте.
EXPO_PUBLIC_WYZIE_KEY=
